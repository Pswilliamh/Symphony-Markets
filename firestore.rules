rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Pillar 0: Global Default-Deny Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Hardened Global Primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isVerifiedUser() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Pillar 2: Validation Blueprint for UserSecuritySession (/users/{userId})
    function isValidUserSecuritySession(data) {
      return data.keys().hasAll([
          'uid',
          'walletModeUnlocked',
          'lastWalletNetwork',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid',
          'walletModeUnlocked',
          'lastWalletNetwork',
          'createdAt',
          'updatedAt'
        ])
        && data.uid is string
        && data.uid.size() >= 1
        && data.uid.size() <= 128
        && data.uid.matches('^[a-zA-Z0-9_\\-]+$')
        && data.uid == request.auth.uid
        && data.walletModeUnlocked is bool
        && data.lastWalletNetwork is string
        && data.lastWalletNetwork.size() >= 4
        && data.lastWalletNetwork.size() <= 32
        && (
          data.lastWalletNetwork == 'Bitcoin' ||
          data.lastWalletNetwork == 'Xaman_XRPL' ||
          data.lastWalletNetwork == 'XRPL' ||
          data.lastWalletNetwork == 'Stellar' ||
          data.lastWalletNetwork == 'EVM_TrustExtension'
        )
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // Pillar 2: Validation Blueprint for WalletSetApproval (/users/{userId}/walletApprovals/{approvalId})
    function isValidWalletSetApproval(data) {
      return data.keys().hasAll([
          'ownerUid',
          'setNumber',
          'coinTicker',
          'walletTarget',
          'publicWalletAddress',
          'buyPrice',
          'sellPrice',
          'quantity',
          'status',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerUid',
          'setNumber',
          'coinTicker',
          'walletTarget',
          'publicWalletAddress',
          'buyPrice',
          'sellPrice',
          'quantity',
          'status',
          'createdAt',
          'updatedAt'
        ])
        && data.ownerUid is string
        && data.ownerUid.size() >= 1
        && data.ownerUid.size() <= 128
        && data.ownerUid.matches('^[a-zA-Z0-9_\\-]+$')
        && data.ownerUid == request.auth.uid
        && data.setNumber is int
        && data.setNumber >= 1
        && data.setNumber <= 10
        && data.coinTicker is string
        && data.coinTicker.size() >= 3
        && data.coinTicker.size() <= 8
        && (
          data.coinTicker == 'BTC' ||
          data.coinTicker == 'XRP' ||
          data.coinTicker == 'XLM'
        )
        && data.walletTarget is string
        && data.walletTarget.size() >= 5
        && data.walletTarget.size() <= 32
        && (
          data.walletTarget == 'TrustWallet' ||
          data.walletTarget == 'Xaman' ||
          data.walletTarget == 'TrustExtension'
        )
        && data.publicWalletAddress is string
        && data.publicWalletAddress.size() >= 4
        && data.publicWalletAddress.size() <= 96
        && data.publicWalletAddress.matches('^[a-zA-Z0-9_\\-]+$')
        && data.buyPrice is number
        && data.buyPrice > 0
        && data.buyPrice <= 1000000
        && data.sellPrice is number
        && data.sellPrice > 0
        && data.sellPrice <= 1000000
        && data.quantity is number
        && data.quantity > 0
        && data.quantity <= 100000000
        && data.status is string
        && data.status.size() >= 6
        && data.status.size() <= 16
        && (data.status == 'dispatched' || data.status == 'signed')
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // Master Gate Helper: Parent session must exist, belong to request.auth.uid, and be unlocked
    function isParentSessionActive(userId) {
      return exists(/databases/$(database)/documents/users/$(userId))
        && get(/databases/$(database)/documents/users/$(userId)).data.uid == request.auth.uid
        && get(/databases/$(database)/documents/users/$(userId)).data.walletModeUnlocked == true;
    }

    // Collection 1: /users/{userId}
    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if false;

      allow create: if isOwner(userId)
        && isValidId(userId)
        && isValidUserSecuritySession(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isValidUserSecuritySession(incoming()) && (
        isOwner(userId)
        && isValidId(userId)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          // Action 1: Lock or Unlock Live Wallet Mode
          incoming().diff(existing()).affectedKeys().hasOnly(['walletModeUnlocked', 'updatedAt'])
          ||
          // Action 2: Update Active Wallet Network + Unlock State
          incoming().diff(existing()).affectedKeys().hasOnly([
            'walletModeUnlocked',
            'lastWalletNetwork',
            'updatedAt'
          ])
        )
      );

      allow delete: if false;

      // Subcollection 2: /users/{userId}/walletApprovals/{approvalId}
      match /walletApprovals/{approvalId} {
        allow get: if isOwner(userId)
          && isValidId(userId)
          && isValidId(approvalId)
          && isParentSessionActive(userId);
        allow list: if false;

        allow create: if isOwner(userId)
          && isValidId(userId)
          && isValidId(approvalId)
          && isValidWalletSetApproval(incoming())
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && isParentSessionActive(userId);

        allow update: if isValidWalletSetApproval(incoming()) && (
          isOwner(userId)
          && isValidId(userId)
          && isValidId(approvalId)
          && incoming().ownerUid == existing().ownerUid
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          // Terminal State Lock: Once 'signed', no subsequent mutations are permitted
          && existing().status != 'signed'
          && (
            // Action 1: Transition from 'dispatched' to terminal 'signed'
            (
              existing().status == 'dispatched'
              && incoming().status == 'signed'
              && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])
            )
            ||
            // Action 2: Refresh 'dispatched' order pricing/sizing prior to signing
            (
              existing().status == 'dispatched'
              && incoming().status == 'dispatched'
              && incoming().diff(existing()).affectedKeys().hasOnly([
                'walletTarget',
                'publicWalletAddress',
                'buyPrice',
                'sellPrice',
                'quantity',
                'updatedAt'
              ])
            )
          )
          && isParentSessionActive(userId)
        );

        allow delete: if false;
      }
    }
  }
}
